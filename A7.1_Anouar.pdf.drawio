        <mxCell id="cayK6bT4oJ5K2qFW-m-x-52" value="&lt;b&gt;&lt;u&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;A7.2&lt;/font&gt;&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;p data-end=&quot;98&quot; data-start=&quot;63&quot;&gt; &lt;strong data-end=&quot;98&quot; data-start=&quot;65&quot;&gt;1.Complejidad Ciclomática V(G):&lt;/strong&gt;&lt;/p&gt;&lt;pre data-end=&quot;154&quot; data-start=&quot;115&quot; class=&quot;overflow-visible! px-0!&quot;&gt;&lt;div class=&quot;contain-inline-size rounded-2xl corner-superellipse/1.1 relative bg-token-sidebar-surface-primary&quot;&gt;&lt;div class=&quot;sticky top-[calc(var(--sticky-padding-top)+9*var(--spacing))]&quot;&gt;&lt;div class=&quot;absolute end-0 bottom-0 flex h-9 items-center pe-2&quot;&gt;&lt;div class=&quot;bg-token-bg-elevated-secondary text-token-text-secondary flex items-center gap-4 rounded-sm px-2 font-sans text-xs&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div dir=&quot;ltr&quot; class=&quot;overflow-y-auto p-4&quot;&gt;&lt;code class=&quot;whitespace-pre!&quot;&gt;&lt;span&gt;&lt;span&gt;V(G) = número de decisiones + 1&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;p data-end=&quot;205&quot; data-start=&quot;156&quot;&gt;En &lt;code data-end=&quot;171&quot; data-start=&quot;159&quot;&gt;if(a || b)&lt;/code&gt; hay &lt;strong data-end=&quot;192&quot; data-start=&quot;176&quot;&gt;2 decisiones&lt;/strong&gt; (&lt;code data-end=&quot;197&quot; data-start=&quot;194&quot;&gt;a&lt;/code&gt; y &lt;code data-end=&quot;203&quot; data-start=&quot;200&quot;&gt;b&lt;/code&gt;).&lt;/p&gt;&lt;p data-end=&quot;230&quot; data-start=&quot;207&quot;&gt;&lt;strong data-end=&quot;230&quot; data-start=&quot;210&quot;&gt;V(G) = 2 + 1 = 3&lt;/strong&gt;&lt;/p&gt;&lt;p data-end=&quot;511&quot; data-start=&quot;468&quot;&gt;&lt;strong data-end=&quot;511&quot; data-start=&quot;470&quot;&gt;2.Prueba del Camino Básico (3 caminos):&lt;/strong&gt;&lt;/p&gt;&lt;p data-end=&quot;230&quot; data-start=&quot;207&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p data-end=&quot;635&quot; data-start=&quot;513&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;a = verdadero → entra al &lt;code data-end=&quot;546&quot; data-start=&quot;542&quot;&gt;if&lt;/code&gt;&lt;br data-end=&quot;549&quot; data-start=&quot;546&quot;&gt;a = falso, b = verdadero → entra al &lt;code data-end=&quot;593&quot; data-start=&quot;589&quot;&gt;if&lt;/code&gt;&lt;br data-end=&quot;596&quot; data-start=&quot;593&quot;&gt;&amp;nbsp;a = falso, b = falso → va al &lt;code data-end=&quot;635&quot; data-start=&quot;629&quot;&gt;else&lt;/code&gt;&lt;/font&gt;&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
